TZ=Europe/Berlin
MW_HTTP_PORT=8080

# Database
MARIADB_ROOT_PASSWORD=ciRootPassw0rd
MARIADB_DATABASE=wikidb
MARIADB_USER=wikiuser
MARIADB_PASSWORD=w1k1pass
MW_DB_HOST=database
MW_DB_PORT=3306
MW_DB_NAME=${MARIADB_DATABASE}
MW_DB_USER=${MARIADB_USER}
MW_DB_PASS=${MARIADB_PASSWORD}

# MediaWiki
MW_CONFIG_FILE="/var/www/html/conf/LocalSettings.php"
MW_SITENAME="Wiki CI"
MW_LANG=de
MW_ADMIN_USER=Admin
MW_ADMIN_PASS=AdminPass123
MW_SITEMAP_GENERATION=true
MW_SITEMAP_RUN_ON_START=true
MW_SITEMAP_IDENTIFIER=wiki
MW_ROTTENLINKS_GENERATION=true
MW_ROTTENLINKS_RUN_ON_START=true

# MemcachePHP
MEMCACHEPHP_ADMIN_USER=admin
MEMCACHEPHP_ADMIN_PASS=supersecret
MW_MEMCACHED_SERVERS=memcached:11211
MEMCACHEPHP_SERVERS=${MW_MEMCACHED_SERVERS}

# ClamAV
CLAMAV_ENABLED=true
COMPOSE_PROFILES=clamav,elasticsearch

# E2E Tests
E2E_PAGE_TITLE=E2E-Tagcloud-Test
E2E_MARK=E2E_TAGCLOUD_OK
E2E_SEARCH_MARK=CirrusE2EQuasar92741
E2E_BAD_URL=http://does-not-exist.invalid/e2e-broken
