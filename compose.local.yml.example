# Copy to compose.local.yml and append it to COMPOSE_FILE in .env.
# Requires an existing Autoheal service configured to monitor autoheal=true labels.
# Labels enable Autoheal and Watchtower for every application service, including optional profiles.
services:
  mediawiki:
    # For a custom settings directory, enable the matching mount below and
    # set MW_CONFIG_FILE in .env to the settings file's path in the container.
    # environment:
    #   MW_CONFIG_FILE: ${MW_CONFIG_FILE}
    # volumes:
    #   - ./data/mediawiki/conf/mw_local_settings:/var/www/html/conf/:rw
    #   - ./data/mediawiki/conf/robots.txt:/var/www/html/robots.txt:ro
    #   - ./data/mediawiki/conf/.htaccess:/var/www/html/.htaccess:ro
    #   - ./data/mediawiki/favicon/:/var/www/html/favicon:ro
    #   - ./data/mediawiki/conf/ads.txt:/var/www/html/ads.txt:ro
    labels:
      autoheal: "true"
      com.centurylinklabs.watchtower.enable: "true"

  database:
    labels:
      autoheal: "true"
      com.centurylinklabs.watchtower.enable: "true"

  clamav:
    # volumes:
    #   - ./data/clamav/conf/clamd.conf:/etc/clamav/clamd.conf:ro
    labels:
      autoheal: "true"
      com.centurylinklabs.watchtower.enable: "true"

  memcached:
    labels:
      autoheal: "true"
      com.centurylinklabs.watchtower.enable: "true"

  memcachephp:
    labels:
      autoheal: "true"
      com.centurylinklabs.watchtower.enable: "true"

  opensearch:
    labels:
      autoheal: "true"
      com.centurylinklabs.watchtower.enable: "true"

  elasticsearch:
    labels:
      autoheal: "true"
      com.centurylinklabs.watchtower.enable: "true"
