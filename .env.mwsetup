# --- Optional Configurations ---
# MediaWiki Configurations when using mw-default-setup.sh
# If you like to generate your own LocalSettings.php, set the path here
# don't change the file name, only the path!
# Setup configuration file inside the container
MW_CONFIG_FILE=/var/www/html/conf/LocalSettings.php
# MediWiki Site
MW_LANG=de
MW_ADMIN_USER=Admin
MW_ADMIN_PASS=AdminPass123
# if you like to activate installed extensions during setup, set them here
# default is empty, so all installed extensions except Wanda/WandaScore will be activated
# MW_ACTIVE_EXTENSIONS=Lockdown Description2 RelatedArticles MobileFrontend WikiCategoryTagCloud RottenLinks
MW_ACTIVE_EXTENSIONS=""
